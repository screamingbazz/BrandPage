String Functions
1. Display all employee names in uppercase
SELECT UPPER(emp_name) AS upper_name
FROM employees;

2. Display all employee names in lowercase
SELECT LOWER(emp_name) AS lower_name
FROM employees;

3. Name along with number of characters
SELECT emp_name, LENGTH(emp_name) AS name_length
FROM employees;

4. First 3 characters of each name
SELECT emp_name, LEFT(emp_name, 3) AS first_3_chars
FROM employees;

5. Last 2 characters of each name
SELECT emp_name, RIGHT(emp_name, 2) AS last_2_chars
FROM employees;

6. Remove leading and trailing spaces
SELECT TRIM(emp_name) AS trimmed_name
FROM employees;

7. Position of letter 'a' in each name
SELECT emp_name, INSTR(LOWER(emp_name), 'a') AS position_of_a
FROM employees;

I used LOWER() so that both a and A are detected.

8. Add "Employee: " before each name
SELECT CONCAT('Employee: ', emp_name) AS employee_label
FROM employees;

