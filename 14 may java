This is where CLI + XML merge happens.

package tests;

import org.testng.annotations.Parameters;
import org.testng.annotations.Test;

public class LoginTest {

    @Test
    @Parameters({"browser", "env"})
    public void loginTest(String browserFromXml, String envFromXml) {

        // CLI override (MOST IMPORTANT PART)
        String browser = System.getProperty("browser", browserFromXml);
        String env = System.getProperty("env", envFromXml);

        System.out.println("Browser: " + browser);
        System.out.println("Environment: " + env);

        // Example usage
        if (browser.equals("chrome")) {
            System.out.println("Launching Chrome driver...");
        }
    }
}
