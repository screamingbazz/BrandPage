4. Manual validation (step-by-step)

Let’s validate structure:

def validate_user(user):
    required_fields = ["id", "name", "age", "email", "skills", "address", "isActive"]

    # check all fields exist
    for field in required_fields:
        if field not in user:
            return False

    # type checks
    if not isinstance(user["skills"], list):
        return False

    if not isinstance(user["address"], dict):
        return False

    address_fields = ["street", "city", "country"]
    for field in address_fields:
        if field not in user["address"]:
            return False

    return True
5. Validate entire response list
valid_users = []

for user in data:
    if validate_user(user):
        valid_users.append(user)
    else:
        print("Invalid user:", user.get("id"))

print("Valid users:", len(valid_users))
